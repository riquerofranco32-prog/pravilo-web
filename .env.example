# Link de Calendly cuando lo tengan (ej: https://calendly.com/praviloarg/sesion)
# Sin esto, los botones de "Reservar" abren WhatsApp directamente.
NEXT_PUBLIC_CALENDLY_URL=

# ID de Google Analytics (ej: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Access Token de Producción de Mercado Pago (server-only, NO usar NEXT_PUBLIC_).
# Sin esto, el paso de pago del wizard de reserva muestra un aviso y el usuario
# puede seguir eligiendo "Efectivo".
MP_ACCESS_TOKEN=
